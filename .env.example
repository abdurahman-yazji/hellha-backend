PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:8080
LOG_LEVEL=info

# Local development only. Keep the JSON file inside the ignored secrets folder.
FIREBASE_SERVICE_ACCOUNT_PATH=secrets/firebase-service-account.json
# Production should use Application Default Credentials. If the platform uses
# a credential file, configure GOOGLE_APPLICATION_CREDENTIALS outside Git.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=hellha_db
DB_USER=postgres
DB_PASSWORD=your_database_password
